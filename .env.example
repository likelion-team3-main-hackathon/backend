APP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_DATABASE=mcc_wellness
MYSQL_USER=mcc_user
MYSQL_PASSWORD=mcc_password
MYSQL_ROOT_PASSWORD=local_root_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=local-development-jwt-secret-must-be-at-least-32-bytes
GOOGLE_CLIENT_ID=local-client
GOOGLE_FAKE_ENABLED=true
REFRESH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
AI_PROVIDER=fake
GOOGLE_API_KEY=
GEMINI_MODEL_ANALYSIS=gemini-3.5-flash-lite
GEMINI_MODEL_ROUTINE=gemini-3.5-flash-lite
GEMINI_MODEL_COACHING=gemini-3.5-flash-lite
AI_PROMPT_DOCUMENT_EXTRACTION_VERSION=document-v3-iso-measured-date
AI_PROMPT_HEALTH_ANALYSIS_VERSION=health-v3-multi-document
AI_PROMPT_ROUTINE_GENERATION_VERSION=routine-v7-explicit-date-range
AI_PROMPT_RECORD_COACHING_VERSION=coaching-v2
AI_PROMPT_MEAL_PHOTO_VERSION=meal-photo-v1
AI_PROMPT_POSE_ANALYSIS_VERSION=pose-analysis-v2
GEMINI_MODEL_MEAL_PHOTO=gemini-3.5-flash-lite
GEMINI_MODEL_POSE_ANALYSIS=gemini-3.5-flash-lite
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=180
# 로컬 AI 응답 확인 전용. 건강정보가 로그에 남으므로 운영에서는 반드시 false로 둡니다.
AI_DEBUG_LOG_RESPONSES=false
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_ZONE=Asia/Seoul
AI_GLOBAL_REQUESTS_PER_MINUTE=30
AI_GLOBAL_REQUESTS_PER_DAY=100
AI_HEALTH_ANALYSIS_PER_USER_DAY=3
AI_ROUTINE_GENERATION_PER_USER_DAY=5
AI_ROUTINE_ADJUSTMENT_PER_USER_DAY=5
AI_RECORD_COACHING_PER_USER_DAY=20
OBJECT_STORAGE_BUCKET_PRIVATE=health-private
OBJECT_STORAGE_BUCKET_PUBLIC=health-public
JAVA_OPTS=-Xms256m -Xmx512m
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
